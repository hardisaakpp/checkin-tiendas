<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <add key="ActiveDirectory:Domain" value="yourdomain.com" />
    <add key="ActiveDirectory:Username" value="admin" />
    <add key="ActiveDirectory:Password" value="password" />
  </appSettings>
  <connectionStrings>
    <add name="DefaultConnection" connectionString="your_connection_string" providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>